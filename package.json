{
  "name": "ai-provider-switcher",
  "displayName": "AI Provider Switcher",
  "description": "Manage and switch Claude Code and Codex official providers, gateways, and models.",
  "version": "0.2.0",
  "publisher": "silver-zhang",
  "repository": {
    "type": "git",
    "url": "https://github.com/Silver-Zhang/ai-provider-switcher.git"
  },
  "bugs": {
    "url": "https://github.com/Silver-Zhang/ai-provider-switcher/issues"
  },
  "homepage": "https://github.com/Silver-Zhang/ai-provider-switcher#readme",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "codex",
    "openai",
    "gateway",
    "provider",
    "switcher",
    "ai"
  ],
  "galleryBanner": {
    "color": "#1f2937",
    "theme": "dark"
  },
  "pricing": "Free",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:aiProviderSwitcher.switchMode",
    "onCommand:aiProviderSwitcher.useOfficial",
    "onCommand:aiProviderSwitcher.useGateway"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiProviderSwitcher.switchMode",
        "title": "AI Provider Switcher: Quick Switch Claude Mode"
      },
      {
        "command": "aiProviderSwitcher.useOfficial",
        "title": "AI Provider Switcher: Use Claude Official Subscription"
      },
      {
        "command": "aiProviderSwitcher.useGateway",
        "title": "AI Provider Switcher: Use Claude Gateway"
      },
      {
        "command": "aiProviderSwitcher.manageGateways",
        "title": "AI Provider Switcher: Manage Claude Gateways"
      },
      {
        "command": "aiProviderSwitcher.addGateway",
        "title": "AI Provider Switcher: Add Claude Gateway"
      },
      {
        "command": "aiProviderSwitcher.removeGateway",
        "title": "AI Provider Switcher: Remove Claude Gateway"
      },
      {
        "command": "aiProviderSwitcher.clearGatewayToken",
        "title": "AI Provider Switcher: Clear Saved Claude Gateway Token"
      },
      {
        "command": "aiProviderSwitcher.openSessionHistory",
        "title": "AI Provider Switcher: Open Claude Session History"
      },
      {
        "command": "aiProviderSwitcher.refreshModels",
        "title": "AI Provider Switcher: Refresh Claude Gateway Models"
      },
      {
        "command": "aiProviderSwitcher.showModels",
        "title": "AI Provider Switcher: Show Claude Gateway Models"
      },
      {
        "command": "aiProviderSwitcher.switchCodexProvider",
        "title": "AI Provider Switcher: Switch Codex Provider"
      },
      {
        "command": "aiProviderSwitcher.useCodexOfficial",
        "title": "AI Provider Switcher: Use Codex Official Provider"
      },
      {
        "command": "aiProviderSwitcher.manageCodexProviders",
        "title": "AI Provider Switcher: Manage Codex Providers"
      },
      {
        "command": "aiProviderSwitcher.addCodexProvider",
        "title": "AI Provider Switcher: Add Codex Provider"
      },
      {
        "command": "aiProviderSwitcher.removeCodexProvider",
        "title": "AI Provider Switcher: Remove Codex Provider"
      },
      {
        "command": "aiProviderSwitcher.clearCodexApiKey",
        "title": "AI Provider Switcher: Clear Codex API Key"
      },
      {
        "command": "aiProviderSwitcher.refreshCodexModels",
        "title": "AI Provider Switcher: Refresh Codex Models"
      },
      {
        "command": "aiProviderSwitcher.showCodexModels",
        "title": "AI Provider Switcher: Show Codex Models"
      },
      {
        "command": "aiProviderSwitcher.selectCodexModel",
        "title": "AI Provider Switcher: Select Codex Model"
      }
    ],
    "configuration": {
      "title": "AI Provider Switcher",
      "properties": {
        "aiProviderSwitcher.gatewayBaseUrl": {
          "type": "string",
          "default": "https://api-sub2api.reallab.eu.cc",
          "description": "Gateway base URL used for Claude Code (ANTHROPIC_BASE_URL)."
        },
        "aiProviderSwitcher.enableGatewayDiscovery": {
          "type": "boolean",
          "default": true,
          "description": "Set CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1 when switching to Gateway mode."
        },
        "aiProviderSwitcher.disableLoginPromptInGateway": {
          "type": "boolean",
          "default": true,
          "description": "Set claudeCode.disableLoginPrompt=true when switching to Gateway mode."
        },
        "aiProviderSwitcher.setAttributionHeaderZero": {
          "type": "boolean",
          "default": true,
          "description": "Set CLAUDE_CODE_ATTRIBUTION_HEADER=0 when switching to Gateway mode."
        },
        "aiProviderSwitcher.gateways": {
          "type": "array",
          "description": "Named Claude gateway profiles. Tokens are stored separately in VS Code Secret Storage.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "baseUrl"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "baseUrl": {
                "type": "string"
              }
            }
          },
          "default": [
            {
              "id": "reallab",
              "name": "RealLab Gateway",
              "baseUrl": "https://api-sub2api.reallab.eu.cc"
            }
          ]
        },
        "aiProviderSwitcher.gatewayModels": {
          "type": "array",
          "description": "Models last returned by each gateway's /v1/models endpoint. This is informational; Claude Code controls its own model picker.",
          "items": {
            "type": "object",
            "required": [
              "gatewayId",
              "models",
              "updatedAt"
            ],
            "properties": {
              "gatewayId": {
                "type": "string"
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "updatedAt": {
                "type": "string"
              }
            }
          },
          "default": []
        },
        "aiProviderSwitcher.codexDefaultModel": {
          "type": "string",
          "default": "gpt-5.6-sol",
          "description": "Default Codex model used before a provider's model list is refreshed."
        },
        "aiProviderSwitcher.codexProviders": {
          "type": "array",
          "description": "Named OpenAI Responses API-compatible Codex providers. API keys are stored separately in VS Code Secret Storage and an encrypted local helper file.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "baseUrl"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "baseUrl": {
                "type": "string"
              }
            }
          },
          "default": [
            {
              "id": "pateway",
              "name": "Pateway",
              "baseUrl": "https://api.pateway.ai"
            }
          ]
        },
        "aiProviderSwitcher.codexModels": {
          "type": "array",
          "description": "Models last returned by each Codex provider's /v1/models endpoint.",
          "items": {
            "type": "object",
            "required": [
              "providerId",
              "models",
              "updatedAt"
            ],
            "properties": {
              "providerId": {
                "type": "string"
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "updatedAt": {
                "type": "string"
              }
            }
          },
          "default": []
        },
        "aiProviderSwitcher.codexActiveProviderId": {
          "type": "string",
          "default": "",
          "description": "Currently selected Codex provider ID."
        },
        "aiProviderSwitcher.codexActiveModel": {
          "type": "string",
          "default": "",
          "description": "Currently selected Codex model."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.5.4"
  }
}
