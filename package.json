{
  "name": "ai-provider-switcher",
  "displayName": "AI Provider Switcher",
  "description": "Manage and switch Claude Code and Codex official providers, gateways, and models.",
  "version": "0.4.2",
  "publisher": "silver-zhang",
  "repository": {
    "type": "git",
    "url": "https://github.com/Silver-Zhang/ai-provider-switcher.git"
  },
  "bugs": {
    "url": "https://github.com/Silver-Zhang/ai-provider-switcher/issues"
  },
  "homepage": "https://github.com/Silver-Zhang/ai-provider-switcher#readme",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "codex",
    "openai",
    "gateway",
    "provider",
    "switcher",
    "ai"
  ],
  "galleryBanner": {
    "color": "#0b1026",
    "theme": "dark"
  },
  "pricing": "Free",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:aiProviderSwitcher.switchMode",
    "onCommand:aiProviderSwitcher.useOfficial",
    "onCommand:aiProviderSwitcher.useGateway"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiProviderSwitcher.switchMode",
        "title": "AI Provider Switcher: Quick Switch Provider"
      },
      {
        "command": "aiProviderSwitcher.openManager",
        "title": "AI Provider Switcher: Open Provider Manager"
      },
      {
        "command": "aiProviderSwitcher.useOfficial",
        "title": "AI Provider Switcher: Use Claude Official Subscription"
      },
      {
        "command": "aiProviderSwitcher.useGateway",
        "title": "AI Provider Switcher: Use Claude Gateway"
      },
      {
        "command": "aiProviderSwitcher.manageGateways",
        "title": "AI Provider Switcher: Manage Claude Gateways"
      },
      {
        "command": "aiProviderSwitcher.addGateway",
        "title": "AI Provider Switcher: Add Claude Gateway"
      },
      {
        "command": "aiProviderSwitcher.removeGateway",
        "title": "AI Provider Switcher: Remove Claude Gateway"
      },
      {
        "command": "aiProviderSwitcher.clearGatewayToken",
        "title": "AI Provider Switcher: Clear Saved Claude Gateway Token"
      },
      {
        "command": "aiProviderSwitcher.openSessionHistory",
        "title": "AI Provider Switcher: Open Claude Session History"
      },
      {
        "command": "aiProviderSwitcher.refreshModels",
        "title": "AI Provider Switcher: Refresh Claude Gateway Models"
      },
      {
        "command": "aiProviderSwitcher.showModels",
        "title": "AI Provider Switcher: Show Claude Gateway Models"
      },
      {
        "command": "aiProviderSwitcher.configureClaudeModelMapping",
        "title": "AI Provider Switcher: Configure Claude Model Mapping"
      },
      {
        "command": "aiProviderSwitcher.configureClaudePermissions",
        "title": "AI Provider Switcher: Configure Claude Command Strategy"
      },
      {
        "command": "aiProviderSwitcher.inspectClaudeConfiguration",
        "title": "AI Provider Switcher: Inspect Other Claude Configuration"
      },
      {
        "command": "aiProviderSwitcher.switchCodexProvider",
        "title": "AI Provider Switcher: Switch Codex Provider"
      },
      {
        "command": "aiProviderSwitcher.useCodexOfficial",
        "title": "AI Provider Switcher: Use Codex Official Provider"
      },
      {
        "command": "aiProviderSwitcher.manageCodexProviders",
        "title": "AI Provider Switcher: Manage Codex Providers"
      },
      {
        "command": "aiProviderSwitcher.addCodexProvider",
        "title": "AI Provider Switcher: Add Codex Provider"
      },
      {
        "command": "aiProviderSwitcher.removeCodexProvider",
        "title": "AI Provider Switcher: Remove Codex Provider"
      },
      {
        "command": "aiProviderSwitcher.clearCodexApiKey",
        "title": "AI Provider Switcher: Clear Codex API Key"
      },
      {
        "command": "aiProviderSwitcher.refreshCodexModels",
        "title": "AI Provider Switcher: Refresh Codex Models"
      },
      {
        "command": "aiProviderSwitcher.showCodexModels",
        "title": "AI Provider Switcher: Show Codex Models"
      },
      {
        "command": "aiProviderSwitcher.configureCodexProxy",
        "title": "AI Provider Switcher: Configure Codex WebSocket Proxy"
      },
      {
        "command": "aiProviderSwitcher.refreshProviderUsage",
        "title": "AI Provider Switcher: Refresh Provider Usage"
      },
      {
        "command": "aiProviderSwitcher.configureProviderUsage",
        "title": "AI Provider Switcher: Configure Provider Usage API"
      }
    ],
    "configuration": {
      "title": "AI Provider Switcher",
      "properties": {
        "aiProviderSwitcher.enableGatewayDiscovery": {
          "type": "boolean",
          "default": true,
          "description": "Set CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1 when switching to Gateway mode."
        },
        "aiProviderSwitcher.disableLoginPromptInGateway": {
          "type": "boolean",
          "default": true,
          "description": "Set claudeCode.disableLoginPrompt=true when switching to Gateway mode."
        },
        "aiProviderSwitcher.setAttributionHeaderZero": {
          "type": "boolean",
          "default": true,
          "description": "Set CLAUDE_CODE_ATTRIBUTION_HEADER=0 when switching to Gateway mode."
        },
        "aiProviderSwitcher.gateways": {
          "type": "array",
          "description": "Named Claude gateway profiles. Tokens are stored separately in VS Code Secret Storage.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "baseUrl"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "baseUrl": {
                "type": "string"
              },
              "modelMapping": {
                "type": "object",
                "description": "Optional mapping from Claude model families and agents to model IDs accepted by this Anthropic-compatible provider.",
                "required": [
                  "mainModel",
                  "opusModel",
                  "sonnetModel",
                  "haikuModel",
                  "subagentModel"
                ],
                "properties": {
                  "mainModel": {
                    "type": "string"
                  },
                  "fableModel": {
                    "type": "string"
                  },
                  "opusModel": {
                    "type": "string"
                  },
                  "sonnetModel": {
                    "type": "string"
                  },
                  "haikuModel": {
                    "type": "string"
                  },
                  "subagentModel": {
                    "type": "string"
                  },
                  "supports1m": {
                    "type": "boolean",
                    "default": false
                  },
                  "effortLevel": {
                    "type": "string",
                    "enum": [
                      "auto",
                      "low",
                      "medium",
                      "high",
                      "xhigh",
                      "max"
                    ]
                  }
                }
              },
              "permissionStrategy": {
                "type": "string",
                "enum": [
                  "auto",
                  "acceptEdits",
                  "manual",
                  "bypassPermissions"
                ],
                "description": "Command execution strategy applied when this Claude provider becomes active."
              },
              "usage": {
                "$ref": "#/contributes/configuration/properties/aiProviderSwitcher.codexProviders/items/properties/usage",
                "description": "Optional read-only JSON usage API configuration."
              }
            }
          },
          "default": []
        },
        "aiProviderSwitcher.gatewayModels": {
          "type": "array",
          "description": "Models last returned by each gateway's /v1/models endpoint. This is informational; Claude Code controls its own model picker.",
          "items": {
            "type": "object",
            "required": [
              "gatewayId",
              "models",
              "updatedAt"
            ],
            "properties": {
              "gatewayId": {
                "type": "string"
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "updatedAt": {
                "type": "string"
              }
            }
          },
          "default": []
        },
        "aiProviderSwitcher.claudeActiveProviderId": {
          "type": "string",
          "default": "",
          "description": "Currently selected Claude custom provider ID."
        },
        "aiProviderSwitcher.codexProviders": {
          "type": "array",
          "description": "Named OpenAI Responses API-compatible Codex providers. Enter only the provider root URL; /v1 is added automatically. API keys are stored separately in VS Code Secret Storage and an encrypted local helper file.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "baseUrl"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "baseUrl": {
                "type": "string"
              },
              "usage": {
                "type": "object",
                "description": "Optional read-only JSON usage API configuration.",
                "required": [
                  "endpoint"
                ],
                "properties": {
                  "endpoint": {
                    "type": "string"
                  },
                  "balanceRemainingPath": {
                    "type": "string"
                  },
                  "balanceUsedPath": {
                    "type": "string"
                  },
                  "currencyPath": {
                    "type": "string"
                  },
                  "fiveHourUsedPercentPath": {
                    "type": "string"
                  },
                  "fiveHourRemainingPercentPath": {
                    "type": "string"
                  },
                  "fiveHourResetPath": {
                    "type": "string"
                  },
                  "weeklyUsedPercentPath": {
                    "type": "string"
                  },
                  "weeklyRemainingPercentPath": {
                    "type": "string"
                  },
                  "weeklyResetPath": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "default": []
        },
        "aiProviderSwitcher.codexModels": {
          "type": "array",
          "description": "Models last returned by each Codex provider's /v1/models endpoint.",
          "items": {
            "type": "object",
            "required": [
              "providerId",
              "models",
              "updatedAt"
            ],
            "properties": {
              "providerId": {
                "type": "string"
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "updatedAt": {
                "type": "string"
              }
            }
          },
          "default": []
        },
        "aiProviderSwitcher.codexActiveProviderId": {
          "type": "string",
          "default": "",
          "description": "Currently selected Codex provider ID."
        },
        "aiProviderSwitcher.codexActiveModel": {
          "type": "string",
          "default": "",
          "description": "Currently selected Codex model."
        },
        "aiProviderSwitcher.providerUsageSnapshots": {
          "type": "array",
          "default": [],
          "description": "Cached non-secret usage, balance, quota-window, and rate-limit snapshots for custom providers."
        },
        "aiProviderSwitcher.codexProxyUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "HTTP(S) proxy address managed by the Configure Codex WebSocket Proxy command. The extension preserves unrelated ~/.codex/.env entries."
        },
        "aiProviderSwitcher.codexProxyMode": {
          "type": "string",
          "enum": [
            "officialOnly",
            "allProviders"
          ],
          "enumDescriptions": [
            "Apply the managed proxy only while using the official OpenAI provider.",
            "Apply the managed proxy while using both official and custom Codex providers."
          ],
          "default": "officialOnly",
          "scope": "machine",
          "description": "Controls whether the managed Codex proxy is active only for the official provider or for all providers."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "sharp": "^0.35.3",
    "typescript": "^5.5.4"
  }
}
