				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "ai-provider-switcher: package and install (VS Code)",
			"type": "npm",
			"script": "install:vsix",
			"problemMatcher": []
		},
		{
			"label": "ai-provider-switcher: package and install (Insiders)",
			"type": "npm",
			"script": "install:vsix:insiders",
			"problemMatcher": []
		}
	]
