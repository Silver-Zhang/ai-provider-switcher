			"type": "npm",
			"script": "compile",
			"group": "build",
			"problemMatcher": [
				"$tsc"
			],
			"label": "npm: compile"
		},
		{
			"label": "ai-provider-switcher: test",
			"type": "npm",
			"script": "test",
